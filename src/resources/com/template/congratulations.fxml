<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="708.0" prefWidth="1280.0" styleClass="page-root"
           stylesheets="@pages.css" xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.template.CongratulationsController">
    <VBox alignment="CENTER" maxWidth="760.0" spacing="22.0">
        <ImageView fitHeight="120.0" fitWidth="120.0" preserveRatio="true" smooth="true">
            <image><Image url="@confetti.png" /></image>
        </ImageView>
        <VBox alignment="CENTER" spacing="2.0">
            <Label styleClass="congrats-title" text="Congratulations!" />
            <Label styleClass="congrats-subtitle" text="You are our first user!" />
        </VBox>
        <Label styleClass="congrats-body" textAlignment="CENTER" wrapText="true"
               text="You will automatically be assigned the admin role. As an admin, you can invite users, assign and manage roles, and ban people." />
        <Label styleClass="congrats-body" textAlignment="CENTER" wrapText="true"
               text="If you wish to take on this responsibility, click accept and you will be taken back to the login screen. Log in again and you are the admin." />
        <Button defaultButton="true" onAction="#handleAccept" prefWidth="320.0"
                styleClass="accept-button" text="A C C E P T" />
    </VBox>
</StackPane>
