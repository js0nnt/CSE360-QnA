<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="708.0" prefWidth="1280.0" styleClass="signup-root"
            stylesheets="@auth.css" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.template.SignupController">
    <VBox layoutX="110.0" layoutY="205.0" prefWidth="430.0" spacing="18.0">
        <Label styleClass="hero-title" text="Create your Account" wrapText="true" />
        <Label styleClass="hero-copy" text="Join Q&amp;A to ask questions and share answers."
               wrapText="true" />
        <Label styleClass="hero-note" text="You can sign in after creating your account." wrapText="true" />
        <Button onAction="#openRules" style="-fx-padding: 0;" styleClass="link-button"
                text="Read the community rules" />
    </VBox>
    <VBox layoutX="665.0" layoutY="75.0" prefWidth="485.0" spacing="10.0"
          styleClass="signup-card">
        <padding><Insets bottom="36.0" left="40.0" right="40.0" top="32.0" /></padding>
        <Label styleClass="form-title" text="Create Account" />
        <Label styleClass="field-label" text="Username" />
        <TextField fx:id="usernameField" promptText="Create a username" styleClass="auth-field" />
        <Label styleClass="field-label" text="Password" />
        <PasswordField fx:id="passwordField" promptText="Create a password" styleClass="auth-field" />
        <Label styleClass="field-label" text="Confirm Password" />
        <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password"
                       styleClass="auth-field" />
        <Label fx:id="errorLabel" minHeight="30.0" styleClass="error-label" wrapText="true" />
        <Button defaultButton="true" maxWidth="1.7976931348623157E308"
                onAction="#handleSignup" styleClass="primary-button" text="REGISTER" />
        <HBox alignment="CENTER" spacing="4.0">
            <Label styleClass="muted-label" text="Already have an account?" />
            <Button onAction="#goToLogin" styleClass="link-button" text="Log in" />
        </HBox>
    </VBox>
</AnchorPane>
