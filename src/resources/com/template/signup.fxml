<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>


<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="12.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.template.SignupController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Sign Up" />
    <TextField fx:id="usernameField" maxWidth="240.0" promptText="Username" />
    <PasswordField fx:id="passwordField" maxWidth="240.0" promptText="Password" />
    <PasswordField fx:id="confirmPasswordField" maxWidth="240.0" promptText="Confirm Password" />
    <Button defaultButton="true" onAction="#handleSignup" text="Sign Up" />
    <Label fx:id="errorLabel" style="-fx-text-fill: red;" />
    <Button onAction="#goToLogin" style="-fx-background-color: transparent; -fx-underline: true;" text="Already have an account? Log in" />
</VBox>
