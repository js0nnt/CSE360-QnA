<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="708.0" prefWidth="1280.0" styleClass="page-root"
           stylesheets="@pages.css" xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.template.RulesController">
    <VBox alignment="CENTER" maxWidth="760.0" spacing="30.0">
        <Label styleClass="rules-title" text="Rules" />
        <VBox spacing="20.0">
            <HBox spacing="18.0">
                <Label minWidth="32.0" styleClass="rule-number" text="1." />
                <Label styleClass="rule-text" wrapText="true" text="No Harmful Misinformation" />
            </HBox>
            <HBox spacing="18.0">
                <Label minWidth="32.0" styleClass="rule-number" text="2." />
                <Label styleClass="rule-text" wrapText="true" text="No spam" />
            </HBox>
            <HBox spacing="18.0">
                <Label minWidth="32.0" styleClass="rule-number" text="3." />
                <Label styleClass="rule-text" wrapText="true" text="All content must be written in English" />
            </HBox>
            <HBox spacing="18.0">
                <Label minWidth="32.0" styleClass="rule-number" text="4." />
                <Label styleClass="rule-text" wrapText="true" text="Be polite and civil." />
            </HBox>
            <HBox spacing="18.0">
                <Label minWidth="32.0" styleClass="rule-number" text="5." />
                <Label styleClass="rule-text" wrapText="true"
                       text="Questions that focus on race, gender, sexuality, religion, or any specific demographic group are not allowed" />
            </HBox>
        </VBox>
        <Button cancelButton="true" onAction="#goBack" styleClass="back-button">
            <graphic>
                <ImageView fitHeight="96.0" fitWidth="96.0" preserveRatio="true" smooth="true">
                    <image><Image url="@back-arrow.png" /></image>
                </ImageView>
            </graphic>
            <tooltip><Tooltip text="Back" /></tooltip>
        </Button>
    </VBox>
</StackPane>
