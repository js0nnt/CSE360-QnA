<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="708.0" prefWidth="1280.0" styleClass="admin-root"
            stylesheets="@admin.css" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.template.AdminController">
    <Label layoutX="72.0" layoutY="50.0" styleClass="brand" text="Q&amp;A" />
    <VBox alignment="CENTER" layoutX="300.0" layoutY="145.0" prefWidth="680.0"
          spacing="22.0" styleClass="admin-card">
        <padding><Insets bottom="52.0" left="55.0" right="55.0" top="52.0" /></padding>
        <Label styleClass="eyebrow" text="ADMIN ACCOUNT" />
        <Label fx:id="titleLabel" styleClass="admin-title" textAlignment="CENTER"
               wrapText="true" />
        <Label fx:id="messageLabel" styleClass="admin-message" textAlignment="CENTER"
               wrapText="true" />
        <HBox alignment="CENTER" spacing="14.0">
            <Button onAction="#goToHome" styleClass="primary-button" text="Continue to Q&amp;A" />
            <Button onAction="#handleLogout" styleClass="secondary-button" text="Log Out" />
        </HBox>
    </VBox>
</AnchorPane>
